# ============================================================
# VelaGesture — .gitignore
# ============================================================

# Build artifacts
build/
out/
*.o
*.a
*.elf
*.hex
*.map
*.bin

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Credentials (never commit)
*.pem
*.key
*.p12
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo

# Temporary
*.tmp
*.bak
*.log
